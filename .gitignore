# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# supabase temp files
supabase/.temp/

# generado en build por scripts/generate-sw-manifest.js — no commitear versiones viejas
/public/sw-manifest.json

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*

# Renders estáticos de scripts/ver-serie-mensual.mts (artefactos, no fuente)
serie-mensual-*.html

# Artefactos de spikes y sondas (no son fuente)
spike-mapa.html
sonda-tiles.html
prueba-tile-roto.html

# Render estatico de la linea de visitas (ver-linea-comercio.mts)
linea-comercio-*.html
